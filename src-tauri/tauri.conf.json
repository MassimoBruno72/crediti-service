{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crediti Service",
  "version": "1.0.0",
  "identifier": "it.massimo.crediti-service",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Crediti Service",
        "width": 1100,
        "height": 800,
        "minWidth": 420,
        "minHeight": 600
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyMDFGNEE0NEZGQzkxRTkKUldUcGtmeFBwUFFCa2l4bHNaM2tNNWRuZWVpVjU0T0VpenY4aGVCY1ZNRHVsVXlTVHVsbFI3dFkK",
      "endpoints": [
        "https://github.com/MassimoBruno72/crediti-service/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
